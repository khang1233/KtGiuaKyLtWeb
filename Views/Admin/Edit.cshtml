@model KtGiuaKy.Models.Course
@{
    ViewData["Title"] = "Sửa học phần";
}

<div class="col-lg-8 mx-auto">
    <div class="glass-panel p-4 mb-4">
        <h1 class="h3 fw-extrabold text-light mb-1">Cập nhật học phần</h1>
        <p class="text-secondary mb-0">Chỉnh sửa thông tin học phần "@Model.Name" trong hệ thống.</p>
    </div>

    <div class="glass-panel p-4">
        <form asp-action="Edit" method="post" enctype="multipart/form-data">
            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
            <input type="hidden" asp-for="Id" />

            <div class="form-group custom-form-group mb-3">
                <label asp-for="Name" class="control-label"></label>
                <input asp-for="Name" class="form-control custom-form-control" placeholder="Nhập tên học phần..." />
                <span asp-validation-for="Name" class="text-danger small"></span>
            </div>

            <div class="row mb-3">
                <div class="form-group custom-form-group col-md-6">
                    <label asp-for="Credits" class="control-label"></label>
                    <input asp-for="Credits" class="form-control custom-form-control" type="number" min="1" max="10" placeholder="Số tín chỉ..." />
                    <span asp-validation-for="Credits" class="text-danger small"></span>
                </div>

                <div class="form-group custom-form-group col-md-6">
                    <label asp-for="CategoryId" class="control-label"></label>
                    <select asp-for="CategoryId" class="form-select custom-form-control custom-form-select" asp-items="ViewBag.Categories">
                        <option value="">-- Chọn danh mục học phần --</option>
                    </select>
                    <span asp-validation-for="CategoryId" class="text-danger small"></span>
                </div>
            </div>

            <div class="form-group custom-form-group mb-3">
                <label asp-for="Lecturer" class="control-label"></label>
                <input asp-for="Lecturer" class="form-control custom-form-control" placeholder="Tên giảng viên phụ trách..." />
                <span asp-validation-for="Lecturer" class="text-danger small"></span>
            </div>

            @if (!string.IsNullOrEmpty(Model.Image))
            {
                <div class="mb-3">
                    <label class="control-label d-block text-secondary mb-2">Ảnh minh họa hiện tại</label>
                    <img src="@Model.Image" alt="Current Image" class="rounded" style="max-height: 120px; border: 1px solid var(--glass-border);" 
                         onerror="this.style.display='none'" />
                </div>
            }

            <div class="form-group custom-form-group mb-3">
                <label asp-for="Image" class="control-label">Đường dẫn ảnh minh họa (URL)</label>
                <input asp-for="Image" class="form-control custom-form-control" placeholder="Nhập URL ảnh hoặc tải tệp thay thế bên dưới..." />
                <span asp-validation-for="Image" class="text-danger small"></span>
            </div>

            <div class="form-group custom-form-group mb-4">
                <label class="control-label">Tải tệp ảnh mới (nếu muốn thay đổi)</label>
                <input type="file" name="imageFile" class="form-control custom-form-control" accept="image/*" />
            </div>

            <div class="d-flex gap-3">
                <button type="submit" class="btn btn-premium-primary px-4">
                    <i class="bi bi-save me-2"></i> Lưu thay đổi
                </button>
                <a asp-action="Index" class="btn btn-outline-light px-4">
                    Hủy bỏ
                </a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
