@model IEnumerable<KtGiuaKy.Models.Course>
@{
    ViewData["Title"] = "Quản lý học phần";
}

<div class="glass-panel p-4 mb-4">
    <div class="d-flex justify-content-between align-items-center flex-wrap gap-3">
        <div>
            <h1 class="h3 fw-extrabold text-light mb-1">Quản Lý Học Phần</h1>
            <p class="text-secondary mb-0">Hệ thống CRUD học phần dành cho quản trị viên.</p>
        </div>
        <a asp-action="Create" class="btn btn-premium-primary d-flex align-items-center">
            <i class="bi bi-plus-lg me-2"></i> Thêm học phần mới
        </a>
    </div>
</div>

<div class="glass-panel p-3">
    <div class="table-responsive">
        <table class="table custom-table">
            <thead>
                <tr>
                    <th>Hình ảnh</th>
                    <th>Tên học phần</th>
                    <th>Số tín chỉ</th>
                    <th>Giảng viên</th>
                    <th>Danh mục</th>
                    <th class="text-center">Hành động</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td>
                            <img src="@(string.IsNullOrEmpty(item.Image) ? "https://images.unsplash.com/photo-1516321318423-f06f85e504b3?w=100&auto=format&fit=crop&q=60" : item.Image)" 
                                 alt="@item.Name" class="rounded" style="width: 70px; height: 45px; object-fit: cover;"
                                 onerror="this.src='https://images.unsplash.com/photo-1516321318423-f06f85e504b3?w=100&auto=format&fit=crop&q=60'" />
                        </td>
                        <td>
                            <strong class="text-light">@item.Name</strong>
                        </td>
                        <td>
                            <span class="text-info">@item.Credits tín chỉ</span>
                        </td>
                        <td>@item.Lecturer</td>
                        <td>@item.Category?.Name</td>
                        <td class="text-center">
                            <div class="d-flex justify-content-center gap-2">
                                <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-outline-info btn-sm">
                                    <i class="bi bi-pencil-square me-1"></i> Sửa
                                </a>
                                <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-premium-danger btn-sm">
                                    <i class="bi bi-trash-fill me-1"></i> Xóa
                                </a>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
