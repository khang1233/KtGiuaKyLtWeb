@model KtGiuaKy.Models.LoginViewModel
@{
    ViewData["Title"] = "Đăng nhập";
}

<div class="glass-panel auth-box">
    <div class="auth-header">
        <i class="bi bi-shield-lock-fill text-info fs-1 d-block mb-2"></i>
        <h2 class="auth-title">Đăng nhập tài khoản</h2>
        <p class="text-secondary mb-0">Học viện Đăng ký Học phần</p>
    </div>

    <form asp-controller="Account" asp-action="Login" asp-route-returnUrl="@ViewData["ReturnUrl"]" method="post">
        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

        <div class="form-group custom-form-group mb-3">
            <label asp-for="Username"></label>
            <div class="input-group">
                <span class="input-group-text bg-transparent border-end-0 border-light border-opacity-10 text-secondary">
                    <i class="bi bi-person"></i>
                </span>
                <input asp-for="Username" class="form-control custom-form-control border-start-0" placeholder="Nhập tên đăng nhập..." />
            </div>
            <span asp-validation-for="Username" class="text-danger small"></span>
        </div>

        <div class="form-group custom-form-group mb-4">
            <label asp-for="Password"></label>
            <div class="input-group">
                <span class="input-group-text bg-transparent border-end-0 border-light border-opacity-10 text-secondary">
                    <i class="bi bi-key"></i>
                </span>
                <input asp-for="Password" class="form-control custom-form-control border-start-0" placeholder="Nhập mật khẩu..." />
            </div>
            <span asp-validation-for="Password" class="text-danger small"></span>
        </div>

        <div class="form-group d-flex justify-content-between align-items-center mb-4">
            <div class="form-check">
                <input asp-for="RememberMe" class="form-check-input" />
                <label class="form-check-label text-secondary small" asp-for="RememberMe">
                    Ghi nhớ đăng nhập
                </label>
            </div>
        </div>

        <button type="submit" class="btn btn-premium-primary w-100 mb-3">
            <i class="bi bi-box-arrow-in-right me-2"></i> Đăng nhập hệ thống
        </button>
    </form>

    <!-- Google Login Integration (Câu 9) -->
    <div class="text-center my-3 text-secondary position-relative">
        <hr class="border-light border-opacity-10" />
        <span class="bg-secondary px-2 text-secondary small position-absolute top-50 start-50 translate-middle" style="background-color: #1b213b !important; border-radius: 4px;">hoặc</span>
    </div>

    <form asp-controller="Account" asp-action="ExternalLogin" asp-route-returnUrl="@ViewData["ReturnUrl"]" method="post">
        <input type="hidden" name="provider" value="Google" />
        <button type="submit" class="btn btn-google w-100 d-flex align-items-center justify-content-center">
            <svg class="me-2" xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24">
                <path fill="#4285F4" d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09z"/>
                <path fill="#34A853" d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z"/>
                <path fill="#FBBC05" d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.06H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.94l2.85-2.22.81-.63z"/>
                <path fill="#EA4335" d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.06l3.66 2.84c.87-2.6 3.3-4.52 6.16-4.52z"/>
            </svg>
            Đăng nhập bằng Google
        </button>
    </form>

    <div class="text-center mt-4">
        <p class="text-secondary mb-0 small">Chưa có tài khoản? <a asp-action="Register" class="text-info text-decoration-none fw-bold">Đăng ký ngay</a></p>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
